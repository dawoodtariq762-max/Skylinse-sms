# SKYLINE SMS — Production Environment Configuration
# Copy this file to .env on your VPS and configure real secrets.

NODE_ENV=production
PORT=4000

# REQUIRED in production. Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-key-32-chars

# Database file location (defaults to backend/data.sqlite)
# DB_FILE=/root/skyline-sms/backend/data.sqlite

# Automatic backups directory (kept safe outside the git pull folder)
BACKUP_ENABLED=true
BACKUP_DIR=/root/skyline-sms-backups
BACKUP_INTERVAL_HOURS=3
BACKUP_RETENTION_DAYS=30

# Provider sync scheduler (API Providers)
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=12
